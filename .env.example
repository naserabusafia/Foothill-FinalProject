# Copy to .env for local development (npm run dev / db:* scripts).
# Inside Docker Compose these values come from docker-compose.yml instead.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://quota:quota@localhost:5433/quota
TEST_DATABASE_URL=postgres://quota:quota@localhost:5433/quota_test
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
ADMIN_API_KEY=dev-admin-key-change-me-0123456789
